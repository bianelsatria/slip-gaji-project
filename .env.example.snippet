# ============================================
# Tambahkan / sesuaikan baris berikut di file .env project Laravel Anda
# ============================================

APP_NAME="Sistem Slip Gaji"
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slip_gaji_db
DB_USERNAME=root
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@slipgaji.test"
MAIL_FROM_NAME="${APP_NAME}"

# Dummy / opsional: dikosongkan = fitur WhatsApp akan mensimulasikan pengiriman
WHATSAPP_API_ENDPOINT=
WHATSAPP_API_TOKEN=
