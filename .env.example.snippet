# ============================================
# Tambahkan / sesuaikan baris berikut di file .env project Laravel Anda
# ============================================

APP_NAME="Sistem Slip Gaji"
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=slip_gaji_db
DB_USERNAME=root
DB_PASSWORD=

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=email.pengirim.anda@gmail.com
MAIL_PASSWORD="16 digit app password dari Google (BUKAN password akun biasa)"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="email.pengirim.anda@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================
# CATATAN PENTING soal email ASLI (bukan simulasi):
# ============================================
# 1. Contoh di atas pakai SMTP Gmail. Kalau punya SMTP kantor/provider lain
#    (Zoho, Outlook, cPanel hosting, dll), ganti MAIL_HOST, MAIL_PORT,
#    MAIL_USERNAME, MAIL_PASSWORD sesuai punya mereka - caranya sama.
# 2. Gmail TIDAK bisa dipakai dengan password akun biasa (akan ditolak).
#    Wajib pakai "App Password" 16 digit:
#    a. Aktifkan 2-Step Verification dulu di akun Google pengirim:
#       https://myaccount.google.com/security
#    b. Buka https://myaccount.google.com/apppasswords
#    c. Buat App Password baru (pilih "Mail"), copy 16 digit yang muncul
#    d. Tempel 16 digit itu (tanpa spasi) ke MAIL_PASSWORD di .env
# 3. Sebelumnya contoh .env di sini pakai sandbox.smtp.mailtrap.io -
#    itu HANYA untuk testing, email tidak akan sampai ke inbox asli.
#    Kalau mau email BENERAN sampai ke karyawan, wajib pakai SMTP asli
#    seperti contoh di atas.
# 4. Setiap ubah file .env, jalankan: php artisan config:clear
#    supaya Laravel membaca ulang konfigurasi yang baru.

# Dummy / opsional: dikosongkan = fitur WhatsApp akan mensimulasikan pengiriman
WHATSAPP_API_TOKEN=

# ============================================
# CARA MENDAPATKAN WHATSAPP_API_TOKEN (WhatsApp ASLI, pakai Fonnte):
# ============================================
# 1. Buka https://fonnte.com, klik "Daftar" / "Register", buat akun (gratis).
# 2. Setelah login, buka menu "Device", klik "Tambah Device" / "Add Device".
# 3. Scan QR code yang muncul memakai WhatsApp di HP Anda
#    (WhatsApp > Perangkat Tertaut > Tautkan Perangkat).
# 4. Setelah device berhasil terhubung (statusnya "Connected"), copy
#    "Token" yang tertera di halaman device tersebut.
# 5. Tempel token itu ke WHATSAPP_API_TOKEN di atas.
# 6. Jangan lupa: php artisan config:clear setelah edit .env.
#
# CATATAN:
# - Akun gratis Fonnte punya kuota terbatas (cukup untuk testing/demo UKK).
# - Nomor tujuan diambil OTOMATIS dari kolom "No. Telepon" data karyawan
#   (bukan nomor device Fonnte Anda) - pastikan data karyawan sudah diisi
#   nomor telepon yang benar (boleh format 08xxx atau 62xxx).
# - Kalau WHATSAPP_API_TOKEN dikosongkan, pengiriman akan disimulasikan
#   (dicatat di storage/logs/laravel.log) tanpa benar-benar mengirim WA.
